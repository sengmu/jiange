	"荆棘阵": "thorns_aura",
	"战鼓": "war_drum",
	"白马阵": "white_horse_formation",
	"玄冰咒": "frost_curse",
	"玄冰爆": "frost_burst",
	"法力燃烧": "mana_burn",
	"幻影斩": "phantom_slash",
	"分身": "clone_split",
	"镜像": "mirror_image",
	"裂空斩": "rift_slash",
	"烈火燎原": "wildfire",
	"雷霆一击": "thunder_strike",
	"地裂脚": "fissure_kick",
	"天火": "sky_fire",
	"束缚": "bind",
	"霹雳闪电": "bolt_chain",
	"天石术": "meteor",
	"蚀心咒": "heart_curse",
	"削铁如泥": "armor_shred",
	"狮子吼": "lion_roar",
	"群体治疗": "mass_heal",
	"治疗术": "heal_self",
	"回生术": "rebirth",
	"五行罩": "five_element_shield",
	"化魔盾": "demon_shield",
	"嗜血": "bloodlust",
	"天下无敌": "invincible",
