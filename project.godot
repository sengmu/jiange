; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jiange Packs Game"
config/description="Original procedural 3D vertical slice: dusk mountain-pass defense."
config/version="0.1.15"
config/icon="res://icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Mobile posture (round 2026-11-13): landscape lock + keep the screen on
; during play. Matches the Android export preset (orientation=0,
; immersive_mode=true); desktop is unaffected.
window/handheld/orientation=0
window/handheld/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.003, 0.008, 0.036, 1)

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[gui]

; Emergency fix 2026-11-13: embed a subsetted Noto Sans CJK SC so Chinese
; renders on Web/APK without relying on system fonts (web export has no
; system-font fallback -> all Chinese showed as tofu boxes). Subset covers
; the 515 CJK/punct chars used in scripts/scenes + ASCII + Latin-1.
; NOTE: in Godot 4 the default-theme font setting is gui/theme/custom_font
; (Godot 3's gui/theme/default_font does not exist here; verified by
; dumping ProjectSettings on 2026-11-13).
theme/custom_font="res://assets/fonts/NotoSansCJKsc-Regular.ttf"

[autoload]

SolanaService="*res://addons/SolanaSDK/Autoload/SolanaService.tscn"
HttpRequestHandler="*res://addons/SolanaSDK/Autoload/HttpRequestHandler.tscn"
Wallet="*res://scripts/wallet.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/SolanaSDK/plugin.cfg")
